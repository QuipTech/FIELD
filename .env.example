# Copy to .env.local for local development.
# ApiUrl output of the chatbot-api stack (no trailing slash)
NEXT_PUBLIC_CHAT_API_URL=
# FIELD backend API base URL, used by the "Book a demo" form (no trailing slash).
# Local: http://localhost:4001
NEXT_PUBLIC_API_BASE_URL=
# Cloudflare Turnstile site key. For local testing, 1x00000000000000000000AA always passes.
# Never put the Turnstile secret key here; it lives only in the backend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
