{
  "name": "field-chatbot-api",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless Bedrock chat API for the FIELD landing page support widget",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "sam build",
    "deploy": "sam build && sam deploy",
    "deploy:guided": "sam build && sam deploy --guided"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.2"
  }
}
